{
  // Cloudflare Workers deploy config (10 Sep 2026 — moving off Netlify,
  // whose credits ran out on 198 production deploys this cycle).
  //
  // This project ships NO Worker code: it is the Vite build in ./dist
  // served as static assets, so there is no "main" entry. The backend
  // lives in the Supabase Edge Function and is deployed separately.
  //
  // "name" MUST match the Cloudflare project name, or `wrangler deploy`
  // publishes to a differently-named Worker than the dashboard shows.
  "name": "iqraifs",
  "compatibility_date": "2026-09-10",

  // Link previews (15 Sep): WhatsApp reads static meta tags, so shared
  // login links previewed as "ILM Network" and parents hesitated. This
  // worker rewrites title/OG tags to the school's own name + logo when
  // the URL names one; static assets still bypass it entirely.
  "main": "worker/index.js",

  // Serve ONLY the school's own domain. Cloudflare otherwise publishes
  // the same app at an auto-generated <name>.<subdomain>.workers.dev
  // address (its own build log warns it enables this by default) — a
  // second public front door nobody chose, indexable by search engines
  // and off-brand if the link ever reaches staff or parents.
  "workers_dev": false,

  "assets": {
    "directory": "./dist",
    // The worker needs the shell to rewrite; unmatched (non-asset)
    // navigations invoke the worker, which serves index.html itself —
    // that IS the SPA fallback now (was not_found_handling before the
    // preview worker existed).
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",

    // The worker must see every NAVIGATION, because it is what puts the
    // school's name on a link preview — WhatsApp and Google never run
    // the app's JavaScript, they read the static shell.
    //
    // Why `true` and not a path list (learned the hard way, 18 Sep):
    // Cloudflare serves a request straight from static assets whenever
    // one matches, and "/" matches index.html, so the worker never ran
    // for the bare domain. Scoping it to ["/"] fixed that but made
    // every OTHER path fall to the SPA asset fallback instead of the
    // worker — so /iqra-ifs and the parents' sign-in link, which had
    // previewed correctly for days, both regressed to "ILM Network".
    //
    // `true` routes everything through the worker, which immediately
    // hands real files (anything with an extension, /assets, /brand)
    // back to env.ASSETS — so static serving is unchanged and every
    // navigation gets the right tags.
    "run_worker_first": true
  }
}
